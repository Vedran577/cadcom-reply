<?xml version="1.0" encoding="UTF-8"?>
<!-- Cadcom – Prijedlog odgovora (Outlook add-in) -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>918765cb-09d6-4848-86cf-cf86fc77cd33</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Cadcom d.o.o.</ProviderName>
  <DefaultLocale>hr-HR</DefaultLocale>
  <DisplayName DefaultValue="Prijedlog odgovora"/>
  <Description DefaultValue="Predlaže odgovor na otvoreni mail u stilu Vedrana Cara (Claude API)."/>
  <IconUrl DefaultValue="https://vedran577.github.io/cadcom-reply/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://vedran577.github.io/cadcom-reply/icon-128.png"/>
  <SupportUrl DefaultValue="https://www.cadcom.hr"/>
  <AppDomains>
    <AppDomain>https://api.anthropic.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://vedran577.github.io/cadcom-reply/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="cadcomReplyGroup">
                <Label resid="groupLabel"/>
                <Control xsi:type="Button" id="cadcomReplyButton">
                  <Label resid="buttonLabel"/>
                  <Supertip>
                    <Title resid="buttonLabel"/>
                    <Description resid="buttonDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://vedran577.github.io/cadcom-reply/icon-16.png"/>
        <bt:Image id="icon32" DefaultValue="https://vedran577.github.io/cadcom-reply/icon-32.png"/>
        <bt:Image id="icon80" DefaultValue="https://vedran577.github.io/cadcom-reply/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://vedran577.github.io/cadcom-reply/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Cadcom"/>
        <bt:String id="buttonLabel" DefaultValue="Predloži odgovor"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonDesc" DefaultValue="Napiše nacrt odgovora na ovaj mail u vašem stilu."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
